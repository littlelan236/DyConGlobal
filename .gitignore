# Python environments, generated packages and caches
.venvs/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local credentials and editor/OS state
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
.ssh/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local migration inputs and all generated run/state artifacts
/.migration/
/state/**
/runs/**
/assets/
/tmp/
/.cache/
/reports/**
/capture/**
/online/**
*.log
*.pid

# Atomic writes, interrupted SSH uploads and process locks.
# Dependency lockfiles under locks/ remain versioned.
.write-*
*.tmp
*.part
*.kv-replay-pending
/baseline/manifest.lock
/enrichment/manifest.lock
/hidden/manifest.lock

# One-off machine-specific diagnostic (supported tools live in hidden/evaluation)
/dense_capture_smoke.py

# Keep the canonical baseline manifest and source; exclude rollout payloads
/baseline/trajectories/**
/baseline/patches/**
/baseline/evaluations/**
/baseline/provenance/**

# Enrichment and hidden-state products belong to local/NAS storage
/enrichment/outputs/**
/enrichment/reports/**
/hidden/outputs/**
/hidden/reports/**
/hidden/online/**
/hidden/spool/**
/hidden/evaluation/outputs/**
/hidden/evaluation/*.json

# Estimator/action source stays tracked; generated datasets and models do not
/difficulty/datasets/*/
/difficulty/checkpoints/**
/difficulty/evaluation/outputs/**
/action/datasets/*/
/action/evaluation/outputs/**
/action/outputs/**
/action/reports/**
# Curated action/provenance summaries and frozen selections remain versioned.
/action/checkpoints/**

# Runtime caches and machine-specific observations
/runtime/cache/**
/runtime/reports/**
/runtime/model-identities/**
/runtime/parallel-artifacts/**
/runtime/serving/*.json
/runtime/serving/*.jsonl
/runtime/serving/*.lock
/runtime/serving/*.sock
/runtime/serving/outputs/
/runtime/serving/logs/

# Checkpoints and package/image archives are assets, not source
/models/
/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
*.whl
*.tar
*.tar.gz
*.tgz

# Generated tensors and analysis databases
*.npy
*.npz
*.pickle
*.pkl
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal

# EasySteer uses the separate pinned vendor/easysteer-vllm overlay.
# Its upstream checkout contains a redundant embedded vLLM source tree.
/vendor/EasySteer/vllm-steer/
/vendor/**/.git/
/vendor/**/.git
/vendor/**/node_modules/
/vendor/**/build/
/vendor/**/dist/

# Preserve deliberate placeholders in otherwise empty functional directories
!.gitkeep
