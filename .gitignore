/vendor/**/node_modules/
/vendor/**/build/
/vendor/**/dist/

# Deliberately curated Markdown reports remain visible
/artifacts/*
!/artifacts/*.md

# Retired one-off root drivers; maintained commands live in package modules
/dense_capture_smoke.py
/finalize_eval27_report.py
